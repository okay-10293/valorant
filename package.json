{
  "name": "valorant-music-client",
  "version": "0.1.0",
  "description": "죽으면 노래가 커지는 발로란트용 유튜브 볼륨 클라이언트",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.okay.valorantmusicclient",
    "productName": "발로란트 리스폰 뮤직",
    "files": [
      "**/*",
      "!dist"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
